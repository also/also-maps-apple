// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is gitignored.
GOOGLE_MAPS_API_KEY = YOUR_KEY_HERE
// Optional, for Cesium ion sources: a token with only the assets:read scope,
// restricted to the assets the app uses (1, Cesium World Terrain; 96188,
// Cesium OSM Buildings).
CESIUM_ION_TOKEN = YOUR_TOKEN_HERE

// Your Apple Developer team ID (Xcode > Settings > Accounts), so device builds
// stay signed when the project is regenerated with xcodegen.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_STYLE = Automatic
