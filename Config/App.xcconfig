// Shared settings. Put your key (and signing team) in Config/Secrets.xcconfig (gitignored):
//   GOOGLE_MAPS_API_KEY = AIza...
// The key needs the Map Tiles API enabled in Google Cloud.
GOOGLE_MAPS_API_KEY =
// Optional: a Cesium ion token (assets:read only) for the ion tile sources.
CESIUM_ION_TOKEN =
CODE_SIGN_STYLE = Automatic
// Entitlements for Debug and Optimized builds on visionOS and iOS. None by
// default, so any team signs them with its wildcard profile. The app's key
// needs App Attest, and universal place links need associated domains, which
// only the maintainer's team can provision; it sets
//   DEBUG_CODE_SIGN_ENTITLEMENTS = Config/AppAttest.entitlements
// in Secrets.xcconfig, which has both. Release builds always have both.
DEBUG_CODE_SIGN_ENTITLEMENTS =
// The macOS Debug build's entitlements: unsandboxed, network client only. The
// maintainer's team can opt in to universal place links with
//   DEBUG_MAC_CODE_SIGN_ENTITLEMENTS = SourcesMac/AlsoMapsMac.Debug.Links.entitlements
DEBUG_MAC_CODE_SIGN_ENTITLEMENTS = SourcesMac/AlsoMapsMac.Debug.entitlements
#include? "Secrets.xcconfig"
